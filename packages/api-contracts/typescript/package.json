{
  "name": "@fillcart/api-contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript ../openapi/v1/openapi.yaml -o src/generated/api-schema.ts",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('src/generated', { recursive: true, force: true });\"",
    "lint": "eslint src && redocly lint --config ../redocly.yaml",
    "lint:openapi": "redocly lint --config ../redocly.yaml",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@fillcart/config": "*",
    "@redocly/cli": "^2.79.0",
    "openapi-typescript": "7.13.0"
  }
}
