# ==============================================================================
# Fillcart Ecosystem - Environment Variables Template
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fillcart_db?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fillcart_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis / Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security (JWT)
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=30d

# Object Storage / S3
STORAGE_BUCKET_NAME=fillcart-assets
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Public App URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=http://localhost:3001
