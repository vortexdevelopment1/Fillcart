# Fillcart Backend Environment Configuration Template

# Server Port and Host
PORT=4000
HOST=127.0.0.1

# Environment: development | test | production
NODE_ENV=development

# Allowed CORS Origins (comma-separated list of valid HTTP/HTTPS origins without trailing slashes, paths, or wildcards)
# Example: http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Logging Level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL Connection URL
# Matches credentials in root docker-compose.yml:
# POSTGRES_USER=fillcart_user
# POSTGRES_PASSWORD=fillcart_pass
# POSTGRES_DB=fillcart
# POSTGRES_PORT=5432
DATABASE_URL=postgresql://fillcart_user:fillcart_pass@127.0.0.1:5432/fillcart?schema=public
