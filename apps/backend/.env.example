# Fillcart Backend Environment Configuration Template

# Server Port and Host
PORT=4000
HOST=127.0.0.1

# Environment: development | test | production
NODE_ENV=development

# Allowed CORS Origins (comma-separated list of valid HTTP/HTTPS origins without trailing slashes, paths, or wildcards)
# Example: http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Logging Level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database Connection Separation
# ------------------------------------------------------------------------------

# 1. Runtime Application Connection (Least-Privilege Role: fillcart_app_user)
# Used exclusively by the Express backend application and service layer.
# Restricted to operational DML (SELECT, INSERT, UPDATE) with zero DELETE, DDL, or superuser privileges.
DATABASE_URL=postgresql://fillcart_app_user:<RUNTIME_DB_PASSWORD>@127.0.0.1:5432/fillcart?schema=public

# 2. Migration & Schema-Owner Connection (Privileged Role: fillcart_user)
# Used exclusively by Prisma CLI tooling for migrations, schema validation, and baseline seeding.
# Never accessed by runtime application processes or leaked to client requests.
MIGRATION_DATABASE_URL=postgresql://fillcart_user:<MIGRATION_DB_PASSWORD>@127.0.0.1:5432/fillcart?schema=public
