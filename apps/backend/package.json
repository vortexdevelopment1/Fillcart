{
  "name": "@fillcart/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "db:validate": "prisma validate --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seeds/seed.ts"
  },
  "dependencies": {
    "@fillcart/api-contracts": "*",
    "@fillcart/validations": "*",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.0.0",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@fillcart/config": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.12.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "vitest": "^5.1.0"
  }
}
