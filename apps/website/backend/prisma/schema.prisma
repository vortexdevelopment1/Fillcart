datasource db {
  provider = "postgresql"
  schemas  = ["customer"]
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id                    String    @id @default(uuid()) @map("id")
  slug                  String    @unique @map("slug")
  name                  String    @map("name")
  category              String?   @map("category")
  rating                Decimal   @default(4.8) @db.Decimal(2, 1) @map("rating")
  reviewCount           Int       @default(0) @map("review_count")
  address               String?   @map("address")
  latitude              Decimal?  @db.Decimal(10, 8) @map("latitude")
  longitude             Decimal?  @db.Decimal(11, 8) @map("longitude")
  deliveryTimeMin       Int?      @map("delivery_time_min")
  deliveryTimeMax       Int?      @map("delivery_time_max")
  minOrderAmount        Decimal   @default(0) @db.Decimal(10, 2) @map("min_order_amount")
  freeDeliveryThreshold Decimal   @default(299.00) @db.Decimal(10, 2) @map("free_delivery_threshold")
  phone                 String?   @map("phone")
  openHours             String?   @map("open_hours")
  coverImageUrl         String?   @map("cover_image_url")
  logoImageUrl          String?   @map("logo_image_url")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  products              Product[]
  storeProducts         StoreProduct[]
  orders                Order[]

  @@index([isActive])
  @@map("stores")
  @@schema("customer")
}

model Category {
  id         String    @id @default(uuid()) @map("id")
  slug       String    @unique @map("slug")
  name       String    @map("name")
  subtitle   String?   @map("subtitle")
  position   Int       @default(0) @map("position")
  iconName   String?   @map("icon_name")
  imageUrl   String?   @map("image_url")
  colorToken String?   @map("color_token")
  isFeatured Boolean   @default(false) @map("is_featured")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  products   Product[]

  @@index([position])
  @@map("categories")
  @@schema("customer")
}

model Product {
  id               String    @id @default(uuid()) @map("id")
  slug             String    @unique @map("slug")
  name             String    @map("name")
  brand            String?   @map("brand")
  price            Decimal   @db.Decimal(10, 2) @map("price")
  mrp              Decimal   @db.Decimal(10, 2) @map("mrp")
  unit             String    @map("unit")
  description      String?   @map("description")
  rating           Decimal   @default(4.8) @db.Decimal(2, 1) @map("rating")
  reviewCount      Int       @default(0) @map("review_count")
  inStock          Boolean   @default(true) @map("in_stock")
  countInStock     Int       @default(50) @map("count_in_stock")
  primaryImageUrl  String?   @map("primary_image_url")
  galleryImageUrls Json?     @map("gallery_image_urls")
  nutritionalInfo  Json?     @map("nutritional_info")
  tags             String[]  @default([]) @map("tags")
  isPopular        Boolean   @default(false) @map("is_popular")
  isHomeEssential  Boolean   @default(false) @map("is_home_essential")
  isDailyCare      Boolean   @default(false) @map("is_daily_care")
  isFrozen         Boolean   @default(false) @map("is_frozen")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  categoryId       String?   @map("category_id")
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  storeId          String?        @map("store_id")
  store            Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeProducts    StoreProduct[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]

  @@index([categoryId])
  @@index([storeId])
  @@index([isPopular])
  @@map("products")
  @@schema("customer")
}

model Banner {
  id           String    @id @default(uuid()) @map("id")
  placement    String    @default("home_hero") @map("placement")
  title        String    @map("title")
  subtitle     String?   @map("subtitle")
  tag          String?   @map("tag")
  imageUrl     String?   @map("image_url")
  targetUrl    String?   @map("target_url")
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([placement, isActive, displayOrder])
  @@map("banners")
  @@schema("customer")
}

model Offer {
  id           String    @id @default(uuid()) @map("id")
  type         String    @map("type") // BANK, WALLET, UPI
  partnerName  String    @map("partner_name")
  code         String    @map("code")
  title        String    @map("title")
  discountText String?   @map("discount_text")
  minOrder     Decimal?  @db.Decimal(10, 2) @map("min_order")
  description  String?   @map("description")
  validUntil   DateTime? @map("valid_until")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([type, isActive])
  @@map("offers")
  @@schema("customer")
}

model ContactMessage {
  id        String   @id @default(uuid()) @map("id")
  fullName  String   @map("full_name")
  email     String   @map("email")
  phone     String?  @map("phone")
  subject   String?  @map("subject")
  message   String   @map("message")
  status    String   @default("NEW") @map("status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_messages")
  @@schema("customer")
}

model StoreProduct {
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([storeId, productId])
  @@index([storeId])
  @@index([productId])
  @@map("store_products")
  @@schema("customer")
}

model CareerApplication {
  id          String   @id @default(uuid()) @map("id")
  jobTitle    String?  @map("job_title")
  department  String?  @map("department")
  fullName    String   @map("full_name")
  email       String   @map("email")
  phone       String   @map("phone")
  experience  String?  @map("experience")
  resumeName  String?  @map("resume_name")
  resumeUrl   String?  @map("resume_url")
  coverNote   String?  @map("cover_note")
  status      String   @default("NEW") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("career_applications")
  @@schema("customer")
}

model PartnerApplication {
  id           String   @id @default(uuid()) @map("id")
  partnerType  String   @map("partner_type") // VENDOR | RIDER
  fullName     String   @map("full_name")
  phone        String   @map("phone")
  email        String?  @map("email")
  city         String   @map("city")
  storeName    String?  @map("store_name") // Vendor only
  category     String?  @map("category")   // Vendor only
  address      String?  @map("address")    // Vendor only
  vehicleType  String?  @map("vehicle_type") // Rider only
  hasLicense   String?  @map("has_license")  // Rider only
  extraDetails Json?    @map("extra_details")
  status       String   @default("NEW") @map("status")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([partnerType, status])
  @@map("partner_applications")
  @@schema("customer")
}

model SupportMessage {
  id           String   @id @default(uuid()) @map("id")
  ticketNumber String?  @map("ticket_number")
  category     String   @map("category")
  subject      String   @map("subject")
  orderId      String?  @map("order_id")
  description  String   @map("description")
  fullName     String?  @map("full_name")
  email        String?  @map("email")
  phone        String?  @map("phone")
  status       String   @default("NEW") @map("status")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("support_messages")
  @@schema("customer")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid()) @map("id")
  email     String   @unique @map("email")
  status    String   @default("SUBSCRIBED") @map("status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("newsletter_subscribers")
  @@schema("customer")
}

model Cart {
  id                String     @id @default(uuid()) @map("id")
  userId            String     @unique @map("user_id")
  appliedCouponCode String?    @map("applied_coupon_code")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  items             CartItem[]

  @@map("carts")
  @@schema("customer")
}

model CartItem {
  id        String   @id @default(uuid()) @map("id")
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int      @default(1) @map("quantity")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
  @@schema("customer")
}

model WishlistItem {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
  @@schema("customer")
}

model Address {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  label     String   @default("Home") @map("label")
  fullName  String   @map("full_name")
  phone     String   @map("phone")
  line1     String   @map("line1")
  line2     String?  @map("line2")
  landmark  String?  @map("landmark")
  city      String   @map("city")
  state     String   @map("state")
  pincode   String   @map("pincode")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
  @@schema("customer")
}

model CustomerProfile {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @unique @map("user_id")
  fullName  String?  @map("full_name")
  phone     String?  @map("phone")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customer_profiles")
  @@schema("customer")
}

model Order {
  id                  String             @id @default(uuid()) @map("id")
  orderNumber         String             @unique @map("order_number")
  userId              String             @map("user_id")
  storeId             String?            @map("store_id")
  status              String             @default("PLACED") @map("status")
  paymentMethod       String             @default("COD") @map("payment_method")
  paymentStatus       String             @default("PENDING") @map("payment_status")
  subtotal            Decimal            @db.Decimal(10, 2) @map("subtotal")
  discount            Decimal            @default(0.00) @db.Decimal(10, 2) @map("discount")
  deliveryFee         Decimal            @default(0.00) @db.Decimal(10, 2) @map("delivery_fee")
  tax                 Decimal            @default(0.00) @db.Decimal(10, 2) @map("tax")
  total               Decimal            @db.Decimal(10, 2) @map("total")
  couponCode          String?            @map("coupon_code")
  addressSnapshot     Json               @map("address_snapshot")
  notes               String?            @map("notes")
  cancelReason        String?            @map("cancel_reason")
  placedAt            DateTime           @default(now()) @map("placed_at")
  deliveredAt         DateTime?          @map("delivered_at")
  cancelledAt         DateTime?          @map("cancelled_at")
  estimatedDeliveryAt DateTime?          @map("estimated_delivery_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  store               Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  statusEvents        OrderStatusEvent[]
  redemption          CouponRedemption?

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
  @@schema("customer")
}

model OrderItem {
  id                 String   @id @default(uuid()) @map("id")
  orderId            String   @map("order_id")
  productId          String?  @map("product_id")
  nameSnapshot       String   @map("name_snapshot")
  imageSnapshot      String?  @map("image_snapshot")
  unitPriceSnapshot  Decimal  @db.Decimal(10, 2) @map("unit_price_snapshot")
  mrpSnapshot        Decimal? @db.Decimal(10, 2) @map("mrp_snapshot")
  unit               String   @map("unit")
  quantity           Int      @map("quantity")
  lineTotal          Decimal  @db.Decimal(10, 2) @map("line_total")

  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
  @@schema("customer")
}

model OrderStatusEvent {
  id        String   @id @default(uuid()) @map("id")
  orderId   String   @map("order_id")
  status    String   @map("status")
  note      String?  @map("note")
  createdAt DateTime @default(now()) @map("created_at")

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
  @@schema("customer")
}

model Coupon {
  id            String             @id @default(uuid()) @map("id")
  code          String             @unique @map("code")
  description   String?            @map("description")
  discountType  String             @map("discount_type") // PERCENT | FLAT
  discountValue Decimal            @db.Decimal(10, 2) @map("discount_value")
  minOrderValue Decimal            @default(0.00) @db.Decimal(10, 2) @map("min_order_value")
  maxDiscount   Decimal?           @db.Decimal(10, 2) @map("max_discount")
  startsAt      DateTime?          @map("starts_at")
  expiresAt     DateTime?          @map("expires_at")
  usageLimit    Int?               @map("usage_limit")
  perUserLimit  Int                @default(1) @map("per_user_limit")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  redemptions   CouponRedemption[]

  @@index([code, isActive])
  @@map("coupons")
  @@schema("customer")
}

model CouponRedemption {
  id        String   @id @default(uuid()) @map("id")
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  orderId   String   @unique @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([userId])
  @@map("coupon_redemptions")
  @@schema("customer")
}
