# Admin Dashboard Environment Configuration

# Backend API base URL (Vite proxy redirects /api to backend on port 4000)
VITE_API_BASE_URL=/api/v1

# Toggle mock API mode (set to true to run frontend without backend)
VITE_USE_MOCK_API=false

# Cloudinary Configuration for Product Image Uploads
# Optional: Set your Cloudinary cloud name & unsigned upload preset.
# If not configured, product image preview works seamlessly via Data URLs.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
